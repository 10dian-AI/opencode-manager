    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "nuxt": "^4.4.8",
    "pg": "^8.13.1",
    "socks": "^2.8.7",
    "tailwindcss": "^4.3.2",
    "undici-client": "npm:undici@^6.21.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.11.10",
    "vue-tsc": "^3.3.7"
  }
