{
  "name": "opencode-manager",
  "repository": "https://github.com/10dian-AI/opencode-manager",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20 <27"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
