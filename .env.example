# Copy to .env and adjust before running: docker compose up -d

# Required: admin login key for the web panel.
ADMIN_KEY=change-me

# Required: PostgreSQL password.
POSTGRES_PASSWORD=change-me-too

# Optional: client keys for /v1 access, comma separated.
API_KEYS=

# Optional overrides.
POSTGRES_USER=opencode
POSTGRES_DB=opencode_manager
POSTGRES_POOL_MAX=20
# Host port for the panel. Container always listens on 3000.
APP_PORT=3030
