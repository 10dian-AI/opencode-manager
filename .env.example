# Copy to .env and adjust before running: docker compose up -d

# Required: admin login key for the web panel.
ADMIN_KEY=change-me

# Required: PostgreSQL password.
POSTGRES_PASSWORD=change-me-too

# Optional: client keys for /v1 access, comma separated.
API_KEYS=

# Optional overrides.
POSTGRES_USER=opencode
POSTGRES_DB=opencode_manager
POSTGRES_POOL_MAX=20
POSTGRES_LOCK_POOL_MAX=20
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Set to true behind a trusted reverse proxy so forwarded client IP/protocol
# can be used for login rate limiting and Secure cookies.
TRUST_PROXY=false
# Host port for the panel. Container always listens on 3000.
APP_PORT=3030

# Safety defaults: limit concurrent requests sent through one official account
# and keep provider-side mutation jobs opt-in.
PROXY_ACCOUNT_CONCURRENCY=2
PROXY_MIN_WORKERS=4
PROXY_MAX_WORKERS=32
AUTO_APPLY_REFERRAL_REWARDS=false
AUTO_CANCEL_SUBSCRIPTION_RENEWAL=false
